/* 吸顶导航 */
.nav-wrap {
  position: sticky;
  top: 0;
  z-index: 100;
  margin: 0 -24rpx 20rpx;
  padding: 8rpx 24rpx 16rpx;
  background: #f5f6f7;
  box-sizing: border-box;
}
.nav {
  display: flex;
  background: #ffffff;
  border-radius: 44rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(27, 58, 34, 0.08);
}
.nav-item {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  color: #5f6b72;
  padding: 14rpx 0;
  border-radius: 36rpx;
  white-space: nowrap;
}
.nav-item.active {
  background: #2E7D32;
  color: #ffffff;
  font-weight: 600;
}

/* 区块头部 */
.section-card {
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
}
.section-head {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}
.section-head::before {
  content: '';
  width: 8rpx;
  height: 36rpx;
  border-radius: 4rpx;
  background: #2E7D32;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.section-head .section-title {
  margin-bottom: 0;
}
.section-content {
  display: block;
  font-size: 27rpx;
  color: #455a64;
  line-height: 1.75;
  margin-bottom: 14rpx;
}
.section-content:last-child {
  margin-bottom: 0;
}

/* 生长周期时间轴 */
.timeline {
  display: flex;
  padding: 8rpx 0 4rpx;
}
.tl-item {
  flex: 1;
  position: relative;
  padding-top: 28rpx;
  text-align: center;
}
.tl-item::before {
  content: '';
  position: absolute;
  top: 9rpx;
  left: 50%;
  width: 100%;
  border-top: 2rpx dashed #c8e0c9;
}
.tl-item:last-child::before {
  display: none;
}
.tl-dot {
  position: relative;
  z-index: 1;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #2E7D32;
  margin: 0 auto 16rpx;
  box-shadow: 0 0 0 6rpx #E8F5E9;
}
.tl-stage {
  font-size: 28rpx;
  font-weight: 700;
  color: #263238;
}
.tl-days {
  font-size: 22rpx;
  color: #8a8f99;
  margin-top: 4rpx;
}
.tl-points {
  margin-top: 12rpx;
}
.tl-point {
  display: block;
  font-size: 23rpx;
  color: #455a64;
  line-height: 1.7;
}
.tl-point::before {
  content: '· ';
  color: #66bb6a;
  font-weight: 700;
}

/* 综合防治 */
.principle-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef0f2;
}
.principle-item:last-child {
  border-bottom: none;
  padding-bottom: 2rpx;
}
.principle-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #263238;
  margin-bottom: 8rpx;
}
.principle-content {
  font-size: 26rpx;
  color: #455a64;
  line-height: 1.7;
}

/* 病害速查宫格 */
.load-state {
  padding: 40rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: #8a8f99;
}
.load-state.error {
  color: #5f6b72;
}
.retry-btn {
  display: inline-block;
  padding: 10rpx 44rpx;
  font-size: 25rpx;
  margin-top: 18rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.grid-item {
  width: 48.5%;
  background: #fbfdfa;
  border-radius: 18rpx;
  padding: 14rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(27, 58, 34, 0.05);
  box-sizing: border-box;
}
.grid-item:active {
  opacity: 0.88;
}
.grid-image {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
  background: #f0f2f4;
}
.grid-image.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.12);
}
.grid-name {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: #263238;
  margin-top: 12rpx;
  line-height: 1.4;
}
.grid-type {
  margin-top: 8rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
}
