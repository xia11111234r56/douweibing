<view class="container detail-page" wx:if="{{detail}}">
  <!-- 主图 -->
  <view class="hero" bindtap="previewMain">
    <image class="hero-image" src="{{detail.image}}" mode="aspectFill" wx:if="{{detail.image}}"></image>
    <view class="hero-image placeholder" wx:else>{{detail.char}}</view>
  </view>

  <!-- 标题 -->
  <view class="card title-card">
    <view class="title-row">
      <text class="disease-name">{{detail.name}}</text>
      <view class="tag tag-light">{{detail.disease_type}}</view>
    </view>
    <text class="name-en" wx:if="{{detail.name_en}}">{{detail.name_en}}</text>
  </view>

  <!-- 病原 -->
  <view class="card" wx:if="{{detail.pathogen}}">
    <text class="section-label">病原</text>
    <text class="section-content">{{detail.pathogen}}</text>
  </view>

  <!-- 症状 -->
  <view class="card" wx:if="{{detail.symptoms}}">
    <text class="section-label">症状</text>
    <text class="section-content">{{detail.symptoms}}</text>
  </view>

  <!-- 发病规律 -->
  <view class="card" wx:if="{{detail.conditions}}">
    <text class="section-label">发病规律</text>
    <text class="section-content">{{detail.conditions}}</text>
  </view>

  <!-- 防治方案 -->
  <view class="card" wx:if="{{detail.treatments.length > 0}}">
    <text class="section-label">防治方案</text>
    <view class="treatment-item" wx:for="{{detail.treatments}}" wx:key="index">
      <view class="tag tag-green treatment-tag">{{item.method_type}}</view>
      <text class="treatment-content">{{item.content}}</text>
    </view>
  </view>

  <!-- 真实病例图库 -->
  <view class="card" wx:if="{{gallery.length > 0}}">
    <text class="section-label">真实病例图库</text>
    <text class="section-desc">下方图片均来自系统实际采集与识别的同一批叶片照片</text>
    <scroll-view class="gallery-scroll" scroll-x>
      <view class="gallery-row">
        <image class="gallery-img" wx:for="{{gallery}}" wx:key="*this" src="{{item}}" mode="aspectFill" bindtap="previewGallery" data-src="{{item}}"></image>
      </view>
    </scroll-view>
  </view>

  <button class="btn-primary cta" bindtap="goRecognize">识别这种病害</button>
  <text class="foot-note">拍照识别可得到该病害在本图中的严重度与对应防治建议</text>
</view>

<view class="load-state" wx:elif="{{loading}}">正在加载…</view>

<view class="load-state error" wx:else>
  <text class="load-error-text">{{loadError}}</text>
  <button class="btn-secondary retry-btn" bindtap="retry">重新加载</button>
</view>
