/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(27, 58, 34, 0.05);
}
.search-icon {
  font-size: 34rpx;
  color: #8a8f99;
  margin-right: 16rpx;
  font-weight: 700;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}
.search-clear {
  font-size: 36rpx;
  color: #c0c6cc;
  padding: 0 8rpx;
}

/* 分类 Tab */
.tab-row {
  display: flex;
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 8rpx;
}
.tab {
  padding: 12rpx 32rpx;
  background: #ffffff;
  border-radius: 34rpx;
  font-size: 25rpx;
  color: #5f6b72;
  border: 2rpx solid #e0e5e8;
  flex-shrink: 0;
  margin-right: 14rpx;
}
.tab:last-child {
  margin-right: 0;
}
.tab.active {
  background: #2E7D32;
  color: #ffffff;
  border-color: #2E7D32;
  font-weight: 600;
}

/* 宫格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.grid-item {
  width: 48.5%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 16rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(27, 58, 34, 0.05);
  box-sizing: border-box;
}
.grid-item:active {
  opacity: 0.88;
}
.grid-image {
  width: 100%;
  height: 260rpx;
  border-radius: 14rpx;
  background: #f0f2f4;
}
.grid-image.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 88rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.12);
}
.grid-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #263238;
  margin-top: 14rpx;
  line-height: 1.4;
}
.grid-type {
  margin-top: 10rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
}

/* 加载与空态 */
.load-state {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8a8f99;
}
.load-error-text {
  display: block;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: #8a8f99;
}
.retry-btn {
  display: inline-block;
  padding: 12rpx 48rpx;
  font-size: 26rpx;
}
.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #5f6b72;
  margin-bottom: 10rpx;
}
.empty-desc {
  font-size: 25rpx;
  color: #b0b6bc;
}
