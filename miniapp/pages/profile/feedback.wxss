.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.subtitle {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1b3a22;
  margin-bottom: 18rpx;
}
.feedback-input {
  width: 100%;
  height: 280rpx;
  font-size: 28rpx;
  line-height: 1.7;
}
.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #b0b6bc;
  margin-top: 10rpx;
}
.contact-input {
  width: 100%;
  padding: 18rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f2f4;
}
.foot-note {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #b0b6bc;
  margin-bottom: 24rpx;
}
.submit-btn {
  font-size: 30rpx;
  font-weight: 600;
}
