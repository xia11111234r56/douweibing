.user-card {
  background: linear-gradient(135deg, #43a047 0%, #2E7D32 100%);
  border-radius: 24rpx;
  padding: 44rpx 34rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  margin-right: 26rpx;
  flex-shrink: 0;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 26rpx;
  flex-shrink: 0;
}
.avatar-char {
  font-size: 48rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
}

.user-detail {
  flex: 1;
}
.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}
.user-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.stats-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx 16rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.stat-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #2E7D32;
  margin-bottom: 8rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.stat-num-small {
  font-size: 26rpx;
  line-height: 38rpx;
}
.stat-label {
  font-size: 24rpx;
  color: #8a8f99;
}
.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #eef0f2;
}

.menu-list {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f2f4;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:active {
  background: #f7faf5;
}
.menu-left {
  display: flex;
  align-items: center;
}
.menu-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.badge-green {
  background: #E8F5E9;
  color: #2E7D32;
}
.badge-teal {
  background: #E0F2F1;
  color: #00796B;
}
.badge-amber {
  background: #FFF3E0;
  color: #EF6C00;
}
.badge-gray {
  background: #f0f2f4;
  color: #5f6b72;
}
.menu-icon {
  width: 32rpx;
  height: 32rpx;
}
.menu-text {
  font-size: 29rpx;
  color: #263238;
}
.danger-text {
  color: #E53935;
}
.menu-arrow {
  font-size: 34rpx;
  color: #c0c6cc;
}

.foot-link {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #8a94a6;
  padding: 0 24rpx 24rpx;
}

/* 资料编辑弹窗 */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.login-content {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  width: 80%;
  max-width: 600rpx;
}
.login-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1b3a22;
  display: block;
  text-align: center;
  margin-bottom: 40rpx;
}
.login-form {
  margin-bottom: 40rpx;
}
.form-item {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}
.form-label {
  font-size: 28rpx;
  color: #5f6b72;
  width: 120rpx;
  flex-shrink: 0;
}
.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  padding: 0;
  margin: 0;
  border: none;
  background: #f0f2f4;
}
.avatar-btn::after {
  border: none;
}
.avatar-preview {
  width: 100%;
  height: 100%;
}
.nickname-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background: #f2f4f6;
  border-radius: 12rpx;
  font-size: 28rpx;
}
