.record-list .record-card {
  margin-bottom: 20rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
}
.record-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
  background: #f0f2f4;
}
.placeholder-block {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
}
.placeholder-char {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.record-disease {
  font-size: 30rpx;
  font-weight: 600;
  color: #263238;
  margin-bottom: 14rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.record-meta {
  display: flex;
  align-items: center;
}
.record-meta .tag {
  font-size: 22rpx;
  padding: 4rpx 18rpx;
  margin-right: 14rpx;
}
.record-time {
  font-size: 24rpx;
  color: #b0b6bc;
  margin-left: auto;
}
.record-fb {
  margin-top: 14rpx;
}
.fb-done {
  display: inline-block;
  font-size: 22rpx;
  color: #2E7D32;
  background: #E8F5E9;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}
.fb-btn {
  display: inline-block;
  font-size: 22rpx;
  color: #E65100;
  background: #FFF3E0;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
}

.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
}
.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #5f6b72;
  margin-bottom: 14rpx;
}
.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #b0b6bc;
  margin-bottom: 40rpx;
}
.empty-btn {
  width: 280rpx;
  font-size: 28rpx;
}
