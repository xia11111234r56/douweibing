/* ===== 全局设计系统 =====
   主色：#2E7D32（深绿，农业/健康感）
   背景：#f5f6f7
   强调：#F1F8E9（浅绿底）、#FF9800（中度）、#E53935（重度/危险）
   全部圆角 20rpx 以内，阴影统一、克制的卡片体系。
   图标一律不用 emoji，用纯排版/编号/色块。
*/

page {
  background-color: #f5f6f7;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
    'Helvetica Neue', Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #263238;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

/* 页面容器 */
.container {
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 60rpx;
}

/* 页面头部 */
.page-header {
  padding: 8rpx 8rpx 28rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1b3a22;
  display: block;
}
.page-desc {
  font-size: 26rpx;
  color: #8a8f99;
  margin-top: 6rpx;
  display: block;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(27, 58, 34, 0.05);
}

/* 按钮体系（深绿主按钮、白底次按钮、浅底幽灵按钮） */
.btn-primary {
  background: #2E7D32;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 22rpx 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  line-height: 1.4;
}
.btn-primary[disabled] {
  background: #c8d2cb;
  color: #ffffff;
}
.btn-primary:active {
  opacity: 0.9;
}

.btn-secondary {
  background: #ffffff;
  color: #2E7D32;
  border: 2rpx solid #2E7D32;
  border-radius: 16rpx;
  padding: 20rpx 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.4;
}
.btn-secondary:active {
  background: #f1f8e9;
}

.btn-ghost {
  background: #f1f8e9;
  color: #2E7D32;
  border-radius: 16rpx;
  padding: 18rpx 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.4;
}
.btn-ghost:active {
  opacity: 0.85;
}

button::after {
  border: none;
}

/* 区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1b3a22;
  display: block;
  margin-bottom: 18rpx;
}
.section-desc {
  font-size: 26rpx;
  color: #8a8f99;
  display: block;
  margin-bottom: 24rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #ffffff;
  flex-shrink: 0;
}
.tag-green { background: #2E7D32; }
.tag-orange { background: #FF9800; }
.tag-red { background: #E53935; }
.tag-gray { background: #9e9e9e; }
.tag-light { background: #f1f8e9; color: #2E7D32; }

/* 分隔线 */
.divider {
  height: 1rpx;
  background: #eef0f2;
  margin: 24rpx 0;
}

/* 空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 40rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #8a8f99;
  margin-bottom: 30rpx;
}

/* 占位色块（无图时的病害缩略） */
.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f1f8e9 0%, #d9ebd2 100%);
  color: #2E7D32;
  font-size: 48rpx;
  font-weight: 700;
}
