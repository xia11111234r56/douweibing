# 生产环境配置模板：复制为 backend/.env 后修改，不要提交到仓库。
# 服务器上生成 JWT 密钥：openssl rand -hex 32

# 数据库：推荐 MySQL（与项目文档一致，评审可查）
DATABASE_URL=mysql+pymysql://dc2:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/dc2?charset=utf8mb4
# 若想先用 SQLite 快速跑通，改为（去掉下面注释）：
# DATABASE_URL=sqlite:////opt/dc2/backend/app.db

# 模型与数据目录（与 systemd WorkingDirectory 对应）
MODEL_DIR=/opt/dc2/backend/models
UPLOAD_DIR=/opt/dc2/backend/uploads
SPATIAL_DIR=/opt/dc2/data/spatial

# JWT 签名密钥（必改！）
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# 天气 API（可选，留空即可）
# WEATHER_API_KEY=
